{
  "tests": [
    {
      "name": "client_context_is_echoed_when_no_w3c_key",
      "handler": "w3c.echoClientContext",
      "request": {},
      "clientContext": {
        "custom": { "value": "hello" },
        "environment": { "stage": "beta" }
      },
      "assertions": [
        {
          "response": {
            "custom": { "value": "hello" },
            "environment": { "stage": "beta" }
          }
        }
      ]
    },

    {
      "name": "client_context_is_null_when_header_absent",
      "handler": "w3c.echoClientContext",
      "request": {},
      "assertions": [
        { "response": null }
      ]
    }
  ]
}
